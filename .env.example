# scripts/migrate-images.js 실행에 필요한 환경변수
# 이 파일을 복사해 .env로 저장하고 실제 값을 채우세요. (.env는 git에 커밋되지 않습니다)

SUPABASE_URL=https://jjwhawwbenfqueijojts.supabase.co

# 주의: service_role 키는 RLS를 모두 무시하는 최고 권한 키입니다.
# Supabase 대시보드 > Settings > API > Project API keys > service_role 에서 확인
# 절대 채팅/커밋/공개 저장소에 붙여넣지 마세요.
SUPABASE_SERVICE_KEY=
